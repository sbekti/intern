# scripts/dev.sh loads the deployed database URL and metrics ConfigMap through
# the current kubectl context and generates local-only authentication secrets.
INTERN_API_LOG_LEVEL=info
INTERN_PROMETHEUS_BASE_URL=http://host.docker.internal:19090

AUTH_PUBLIC_BASE_URL=http://127.0.0.1:3000
AUTH_JWT_ISSUER=intern.local
AUTH_JWT_AUDIENCE=internctl
AUTH_ADMIN_GROUPS=Super-Users

# scripts/dev.sh enables identity injection and generates its private marker.
INTERN_DEV_IDENTITY_MARKER_HEADER=X-Intern-Forward-Auth
INTERN_DEV_IDENTITY_USER=dev-user
INTERN_DEV_IDENTITY_NAME=Development User
INTERN_DEV_IDENTITY_EMAIL=developer@example.invalid
INTERN_DEV_IDENTITY_GROUPS=Users,Super-Users
INTERN_TRUSTED_PROXY_CIDRS=172.16.0.0/12
# Listen on every host interface. Use 127.0.0.1 to restrict access to this machine.
INTERN_WEB_BIND=0.0.0.0
INTERN_WEB_PORT=3000
