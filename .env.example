# The API intentionally connects to this explicitly configured production database.
# Use a read-only smoke credential unless you intentionally need human writes.
INTERN_API_DATABASE_URL=postgres://replace-with-explicit-production-credential@db.example.invalid/intern?sslmode=require
INTERN_API_LOG_LEVEL=info
INTERN_PROMETHEUS_BASE_URL=http://host.docker.internal:19090

AUTH_PUBLIC_BASE_URL=https://intern.bekti.com
AUTH_JWT_ISSUER=intern.bekti.com
AUTH_JWT_AUDIENCE=internctl
AUTH_JWT_HMAC_SECRET=replace-with-a-long-random-secret
AUTH_ADMIN_GROUPS=Super-Users

# The marker is private configuration shared by the development web BFF and API.
# scripts/dev.sh keeps identity injection disabled unless --dev-identity is passed.
INTERN_DEV_IDENTITY_ENABLED=false
INTERN_DEV_IDENTITY_MARKER_HEADER=X-Intern-Forward-Auth
INTERN_DEV_IDENTITY_MARKER=replace-with-a-random-development-marker
INTERN_DEV_IDENTITY_USER=replace-with-development-user
INTERN_DEV_IDENTITY_NAME=Development User
INTERN_DEV_IDENTITY_EMAIL=developer@example.invalid
INTERN_DEV_IDENTITY_GROUPS=Users
INTERN_TRUSTED_PROXY_CIDRS=172.16.0.0/12
# Listen on every host interface. Use 127.0.0.1 to restrict access to this machine.
INTERN_WEB_BIND=0.0.0.0
INTERN_WEB_PORT=3000
