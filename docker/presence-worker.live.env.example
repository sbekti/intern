# Copy the needed values into .env.presence.local in the repo root.
# The real .env.presence.local file is ignored by git.
#
# Start local dev with:
#   docker compose up --build
#
# Optional live-source run with your local overrides:
#   docker compose --env-file .env.presence.local up --build
#
# For local UniFi access, use a port-forward and point the host to
# host.docker.internal from inside the worker container.
#
# Example:
# kubectl -n default port-forward svc/unifi 18443:443

INTERN_PRESENCE_ENABLED=true
INTERN_PRESENCE_POLL_INTERVAL_DEFAULT=5m
INTERN_PRESENCE_DISCONNECT_GRACE_DEFAULT=15m
INTERN_PRESENCE_SOURCES_JSON=[{"key":"unifi-iad2","type":"unifi","displayName":"IAD2 UniFi","host":"host.docker.internal","port":18443,"site":"default","insecureSkipVerify":true,"pollInterval":"5m","disconnectGrace":"15m","credentialEnv":{"username":"INTERN_PRESENCE_SOURCE_UNIFI_IAD2_USERNAME","password":"INTERN_PRESENCE_SOURCE_UNIFI_IAD2_PASSWORD"}},{"key":"juniper-jfk1","type":"juniper-snmp","displayName":"JFK1 Juniper","host":"10.20.0.10","port":161,"pollInterval":"5m","disconnectGrace":"15m","credentialEnv":{"snmpUsername":"INTERN_PRESENCE_SOURCE_JUNIPER_JFK1_SNMP_USERNAME","snmpAuthProtocol":"INTERN_PRESENCE_SOURCE_JUNIPER_JFK1_SNMP_AUTH_PROTOCOL","snmpAuthPassword":"INTERN_PRESENCE_SOURCE_JUNIPER_JFK1_SNMP_AUTH_PASSWORD","snmpPrivProtocol":"INTERN_PRESENCE_SOURCE_JUNIPER_JFK1_SNMP_PRIV_PROTOCOL","snmpPrivPassword":"INTERN_PRESENCE_SOURCE_JUNIPER_JFK1_SNMP_PRIV_PASSWORD"}}]

INTERN_PRESENCE_SOURCE_UNIFI_IAD2_USERNAME=
INTERN_PRESENCE_SOURCE_UNIFI_IAD2_PASSWORD=

INTERN_PRESENCE_SOURCE_JUNIPER_JFK1_SNMP_USERNAME=
INTERN_PRESENCE_SOURCE_JUNIPER_JFK1_SNMP_AUTH_PROTOCOL=SHA
INTERN_PRESENCE_SOURCE_JUNIPER_JFK1_SNMP_AUTH_PASSWORD=
INTERN_PRESENCE_SOURCE_JUNIPER_JFK1_SNMP_PRIV_PROTOCOL=AES128
INTERN_PRESENCE_SOURCE_JUNIPER_JFK1_SNMP_PRIV_PASSWORD=
